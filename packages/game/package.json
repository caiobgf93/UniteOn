{
  "name": "@uniteon/game",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(game) no lint yet\"",
    "assets:fetch": "bash scripts/fetch-lpc-sources.sh",
    "assets:recolor": "node scripts/run-lpc-recolor.mjs",
    "assets:build": "npm run assets:fetch && npm run assets:recolor",
    "map:build": "node scripts/build-office-map.mjs",
    "map:preview": "node scripts/render-map-preview.mjs"
  },
  "dependencies": {
    "@uniteon/shared": "workspace:*",
    "pixi.js": "^8.4.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0"
  }
}
