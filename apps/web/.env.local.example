# Variáveis PÚBLICAS do cliente (Next inlina no build). Copie para `.env.local`.
# Enquanto vazias, o app usa o mock de dev (/office?name=Fulano) sem login.

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL do servidor realtime (default já é este):
NEXT_PUBLIC_REALTIME_URL="http://localhost:3002"
