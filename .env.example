# ─── Banco ───────────────────────────────────────────────
DATABASE_URL="postgresql://uniteon:uniteon@localhost:5432/uniteon?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET="dev-change-me"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
OAUTH_CALLBACK_BASE_URL="http://localhost:3001"

# ─── Mídia (LiveKit) ─────────────────────────────────────
