# ─── Banco (Supabase Postgres) ───────────────────────────
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL: Transaction pooler (porta 6543) para queries.
# DIRECT_URL: Session pooler (porta 5432) para migrations.
DATABASE_URL="postgresql://postgres:pass@localhost:5432/uniteon?schema=public"
DIRECT_URL="postgresql://postgres:pass@localhost:5432/uniteon?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Auth (Supabase) ─────────────────────────────────────
# Supabase → Project Settings → API. Login por e-mail/senha.
# SUPABASE_JWT_SECRET = "JWT Secret" (o realtime valida o token do usuário com ele).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# ─── Mídia (LiveKit) ─────────────────────────────────────
LIVEKIT_URL="wss://YOUR_PROJECT.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ─── Storage (S3) ────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET="uniteon-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─── Portas / URLs ───────────────────────────────────────
WEB_URL="http://localhost:3000"
API_PORT=3001
REALTIME_PORT=3002
CORS_ORIGINS="http://localhost:3000"
