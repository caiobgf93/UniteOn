# ─── Storage (S3) ────────────────────────────────────────
S3_ENDPOINT=""
S3_BUCKET="uniteon-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─── Portas / URLs ───────────────────────────────────────
WEB_URL="http://localhost:3000"
API_PORT=3001
REALTIME_PORT=3002
CORS_ORIGINS="http://localhost:3000"
